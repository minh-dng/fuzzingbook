# Dockerfile for testing fuzzingbook on linux/arm64 with z3-solver
# Build with:
#   docker build --platform linux/arm64 -f Dockerfile.linux-arm64 -t fuzzingbook-arm64-test .
# Run with:
#   docker run --rm --platform linux/arm64 fuzzingbook-arm64-test
#
# Base uses trixie (glibc 2.41) so that z3-solver>=4.16 (manylinux_2_38_aarch64)
# wheels work. bookworm/jammy (glibc 2.36/2.35) only support z3<=4.15.x.
# NOTE: build with --platform linux/arm64 (do not hardcode FROM --platform).
FROM python:3.12-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps: graphviz for pygraphviz, gcc for datrie (isla dep),
# clang/cargo/bc/etc. from binder/apt.txt, libmagic for python-magic
RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz libgraphviz-dev \
    gcc g++ python3-dev \
    clang cargo \
    bc groff ed texinfo \
    libmagic1 curl git make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy only what `pip install .` needs (repo is 1.6G, avoid full docs/).
# docs/code/ holds the committed generated code (used to catch z3 breakage).
COPY pyproject.toml README.md LICENSE.md ./
COPY Chapters.makefile Makefile ./
COPY python_code/ ./python_code/
COPY notebooks/ ./notebooks/
COPY utils/ ./utils/
COPY docs/code/ ./docs_code/

# Upgrade pip, then install the project (tests dependency resolution on arm64).
# No setuptools pin: isla no longer needs pkg_resources, so a fresh env with
# stock setuptools (v84+, no pkg_resources) must work. Both must be present;
# fail loudly if not (the old markers used to silently skip them on arm64).
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir . && \
    pip show z3-solver isla-solver

# Smoke test: z3 + isla must import and solve on linux/aarch64
RUN python3 -c "import platform; print('machine:', platform.machine())" && \
    python3 -c "import z3; print('z3 version:', z3.get_version()); s = z3.Solver(); x = z3.Int('x'); s.add(x > 0); assert s.check() == z3.sat; print('z3 smoke: sat, model =', s.model())" && \
    python3 -c "from isla.solver import ISLaSolver; s = ISLaSolver(grammar='<start> ::= \"a\"'); print('isla smoke:', s.solve())"

# Populate the installed package with the committed generated code (the same
# content `make code` produces, and what `make dist` ships), then reinstall,
# so every check below exercises the INSTALLED fuzzingbook package itself.
RUN cp docs_code/*.py python_code/ && \
    pip install --no-cache-dir --no-deps --force-reinstall . && \
    pip show -f fuzzingbook | grep -E "ConcolicFuzzer.py|SymbolicFuzzer.py" && \
    python3 -c "import fuzzingbook.ConcolicFuzzer, fuzzingbook.SymbolicFuzzer, fuzzingbook.FuzzingWithConstraints, fuzzingbook.PrototypingWithPython; print('installed fuzzingbook imports ok')"

# Functional checks through the installed package + new z3 + forked isla.
RUN python3 -c "from fuzzingbook.Fuzzer import RandomFuzzer; print('RandomFuzzer:', repr(RandomFuzzer().fuzz()))" && \
    python3 -c "from fuzzingbook.FuzzingWithConstraints import US_PHONE_GRAMMAR; from isla.solver import ISLaSolver; s = ISLaSolver(US_PHONE_GRAMMAR, max_number_free_instantiations=1, max_number_smt_instantiations=1); print('installed-package isla solve:', s.solve())"

# NOTE: `CI=true make -k code` currently fails on Coverage.py (NameError: Any)
# due to a pre-existing export bug (notebooks/Coverage.ipynb has two
# "## Synopsis" blocks; the first block's `from typing import ...` cell is
# discarded by export_notebook_code.py). Unrelated to z3/arm64; not fixed here.
# RUN CI=true make -k code

# Regression test for ISLa interop: importing isla.solver first must not break
# symbolic fuzzing. isla patches z3.ExprRef.__eq__ process-wide; the chapters
# build formulas via symbolic_eq(), immune to the patch.
RUN python3 -c "import isla.solver; from fuzzingbook.SymbolicFuzzer import SimpleSymbolicFuzzer, check_triangle; fz = SimpleSymbolicFuzzer(check_triangle, max_iter=3); res = fz.fuzz(); assert set(res) == {'a', 'b', 'c'} and all(v is not None for v in res.values()); cls = check_triangle(*[res[k].as_long() for k in 'abc']); assert cls in {'Equilateral', 'Isosceles', 'Scalene'}; print('mixed-use symbolic fuzz ok:', res, '->', cls)"

CMD ["python3", "-c", "import z3; print('fuzzingbook linux/arm64 OK, z3 =', z3.get_version())"]
